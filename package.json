{
  "name": "kema-lab-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "check:cloudflare": "wrangler deploy --dry-run",
    "build:share": "node scripts/build-share.mjs",
    "deploy:share": "npm run build:share && wrangler deploy --config wrangler.share.jsonc"
  },
  "devDependencies": {
    "wrangler": "^4.151.1"
  }
}
